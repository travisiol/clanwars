# FIFTY — environment
#
# Every one of these is optional and the site is honest without them. With the
# contract addresses unset, the board on the page is the simulated season and
# says so where it is drawn, the connect button states its reason, and nothing
# fakes a deployment that has not happened.

# ---- the site ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://fifty.example
NEXT_PUBLIC_FIFTY_X=
NEXT_PUBLIC_FIFTY_TELEGRAM=

# ---- the contracts -------------------------------------------------------
# The token, the game module (clans, seats, map, votes), and the pool the fee
# is collected from. The pool is also the first address that must never be
# allowed to occupy a seat.
NEXT_PUBLIC_FIFTY_TOKEN_ADDRESS=
NEXT_PUBLIC_FIFTY_MAP_ADDRESS=
NEXT_PUBLIC_FIFTY_POOL_ADDRESS=

# The master switch. Even set to true, the surfaces above stay disabled until
# their addresses are present — this flag can only turn things off.
NEXT_PUBLIC_FIFTY_LIVE=false

# ---- the chain -----------------------------------------------------------
# Defaults are in src/lib/chain.ts and were gathered from public third-party
# sources. Re-verify against the official docs before pointing this at real
# funds.
NEXT_PUBLIC_ROBINHOOD_CHAIN_ID=4663
NEXT_PUBLIC_ROBINHOOD_RPC_URL=
NEXT_PUBLIC_ROBINHOOD_EXPLORER_URL=
